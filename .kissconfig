# Generated by kiss check
# Thresholds based on max values of analyzed codebase

[global]
min_similarity = 0.9
duplication_enabled = true
orphan_module_enabled = false
comment_removal_enabled = true
docs_allowed = ["./"]
orphan_allowed = []

[test]
test_coverage_threshold = 80
test_coverage_scope = "codebase"
max_num_tests = 1500
num_jobs = 4
watch_settle_seconds = 1.0
pytest_plugins = []
ignore = [
    "fake_",
    "fixtures",
    "defer_enrich_live",
    "test_kiss_static_coverage",
    "test_drain_idle_cov",
    "test_kiss_probe_static",
    "user_home_dir_tests",
    "macos",
    "other.rs",
    "windows_fake_command",
]

[test.max_unit_test_seconds]
"*" = 5

[python]
statements_per_function = 86
positional_args = 4
keyword_only_args = 9
max_indentation = 7
nested_function_depth = 1
returns_per_function = 13
return_values_per_function = 3
branches_per_function = 22
local_variables = 22
statements_per_try_block = 32
boolean_parameters = 3
decorators_per_function = 11
calls_per_function = 86
methods_per_class = 3
statements_per_file = 2717
lines_per_file = 5590
functions_per_file = 236
interface_types_per_file = 0
concrete_types_per_file = 5
imported_names_per_file = 31
indirect_dependencies = 4
dependency_depth = 3
cycle_size = 0

[rust]
statements_per_function = 26
arguments = 4
max_indentation = 4
nested_function_depth = 2
returns_per_function = 5
branches_per_function = 9
local_variables = 13
boolean_parameters = 1
attributes_per_function = 2
calls_per_function = 20
methods_per_class = 11
statements_per_file = 162
lines_per_file = 239
functions_per_file = 22
interface_types_per_file = 0
concrete_types_per_file = 4
imported_names_per_file = 20
indirect_dependencies = 9
dependency_depth = 3
cycle_size = 0

