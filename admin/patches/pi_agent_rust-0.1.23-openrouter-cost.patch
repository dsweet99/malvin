+fn apply_openrouter_usage_cost(usage: &OpenAIUsage, cost: &mut crate::model::Cost) {
+    if let Some(details) = &usage.cost_details {
+        if let Some(v) = details.upstream_inference_prompt_cost {
+            cost.input = v;
+        }
+        if let Some(v) = details.upstream_inference_completions_cost {
+            cost.output = v;
+        }
+        if let Some(v) = details.upstream_inference_cost {
+            cost.total = v;
+        }
+    }
+    if let Some(v) = usage.cost {
+        cost.total = v;
+    }
+    if cost.total <= 0.0 && (cost.input > 0.0 || cost.output > 0.0) {
+        cost.total = cost.input + cost.output + cost.cache_read + cost.cache_write;
+    }
+}
+
+use std::cell::RefCell;
+
+thread_local! {
+    static OPENROUTER_GENERATION_IDS: RefCell<Vec<String>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Generation ids from recent OpenRouter streaming responses (`X-Generation-Id` header).
+pub fn take_openrouter_generation_ids() -> Vec<String> {
+    OPENROUTER_GENERATION_IDS.with(|ids| std::mem::take(&mut *ids.borrow_mut()))
+}
+
+fn note_openrouter_generation_id(id: &str) {
+    let id = id.trim();
+    if !id.is_empty() {
+        OPENROUTER_GENERATION_IDS.with(|ids| ids.borrow_mut().push(id.to_string()));
+    }
+}
